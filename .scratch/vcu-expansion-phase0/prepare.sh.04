    'research_freeze_sha256':'00e9a95396eb4ca4aafcfd51243edd68872723db16249b5c4ca633b3ea485dc9',
    'stage1_independent_proof_sha256':os.environ['PROOF_SHA'],
    'integration_freeze_sha256':os.environ['INTEGRATION_SHA'],
    'expansion_research_checkpoint':{
        'sha256':'00e9a95396eb4ca4aafcfd51243edd68872723db16249b5c4ca633b3ea485dc9',
        'research_base_sha':'df73675852ec5a43dfac50da0ee06d8bcabf8832',

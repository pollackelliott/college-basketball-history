raw=json.dumps(request,indent=2,sort_keys=True)+'\n'
Path('/tmp/control/.remote-implementation/request.json').write_text(raw)
PY

PYTHONPATH=/tmp/runtime/tools python - <<'PY'
import json
from pathlib import Path
from remote_implementation_control import validate_control_state, validate_request
control=Path('/tmp/control')
state=json.loads((control/'.remote-implementation/control-state.json').read_text())
request=json.loads((control/'.remote-implementation/request.json').read_text())
validate_control_state(state)
validate_request(request)
PY

git -C /tmp/control add -- .remote-implementation/request.json
git -C /tmp/control commit -m "Queue VCU expansion Phase 0 request ${REQUEST_ID}"
REQUEST_COMMIT="$(git -C /tmp/control rev-parse HEAD)"
git -C /tmp/control push origin HEAD:refs/heads/${CONTROL_BRANCH} \
  --force-with-lease=refs/heads/${CONTROL_BRANCH}:${TRANSPORT_COMMIT}

gh api --method POST \
  "repos/${GITHUB_REPOSITORY}/actions/workflows/remote-implementation.yml/dispatches" \
  -f ref="${CONTROL_BRANCH}"

echo "Submitted ${REQUEST_ID} at control commit ${REQUEST_COMMIT}"
echo "Protected main: ${MAIN_SHA}"
echo "Stage 1 proof: ${PROOF_SHA}"
echo "Integration Freeze: ${INTEGRATION_SHA}"
